"use client";

// Halaman "Tambah Kuisioner" — Figma page component `kuisioner` →
// variabel `add_pertanyaan` (node 1105:23051).
//
// Susunan sesuai desain:
//   header halaman : tombol kembali + 2 tombol aksi + judul + label status
//                    (TIDAK ada tombol tambah pertanyaan di sini)
//   kolom kiri     : `daftar_layout` (1103:22459) — punya 2 varian:
//                      - no_question : state kosong + tombol tambah
//                      - default     : daftar kartu pertanyaan + tombol tambah
//   kolom kanan    : Konfigurasi Kuisioner (1103:22474)
//
// Semua ikon memakai lucide-react.

import { useCallback, useEffect, useState } from "react";

import Link from "next/link";

import { ChevronLeft, HelpCircle, Plus } from "lucide-react";

import { AddQuestionPopup } from "@/components/admin/kuisioner/AddQuestionPopup";
import { QuestionnaireConfigPanel } from "@/components/admin/kuisioner/QuestionnaireConfigPanel";
import QuestionEditorCard from "@/components/admin/kuisioner/QuestionEditorCard";
import { useQuestionnaireBuilder } from "@/hooks/useQuestionnaireBuilder";

const STATUS_LABEL = "Draf";

// Tombol bulat dasar (button_components di Figma): h-40.545, radius 1000.
const pillBase =
  "flex h-[40.545px] cursor-pointer items-center justify-center rounded-[1000px] px-[30px] text-[12px] leading-[16px] font-normal whitespace-nowrap transition-opacity hover:opacity-90";

function PageHeader() {
  return (
    <div className="flex w-full flex-col gap-[15px]">
      <div className="flex w-full flex-wrap items-center justify-between gap-[15px]">
        <Link
          href="/admin/kuesioner"
          className="flex shrink-0 items-center gap-[10px] text-figma-blue-800 transition-opacity hover:opacity-70"
        >
          <ChevronLeft className="size-[24px]" strokeWidth={1.5} aria-hidden="true" />
          <span className="text-[14px] leading-[20px] font-medium">Kembali</span>
        </Link>

        <div className="flex items-center gap-[10px]">
          <button
            type="button"
            className={`${pillBase} border border-solid border-figma-blue-400 text-figma-blue-800 hover:bg-figma-blue-100`}
          >
            Simpan sebagai Draf
          </button>
          <button
            type="button"
            className={`${pillBase} bg-figma-blue-500 text-figma-blue-50`}
          >
            Publikasikan
          </button>
        </div>
      </div>

      <div className="flex flex-wrap items-center gap-[15px]">
        <h1 className="text-[24px] leading-[32px] font-bold text-figma-blue-800">
          Kuisioner Tracer Study Alumni
        </h1>
        <span className="flex items-center justify-center rounded-[1000px] bg-figma-blue-100 px-[15px] py-[5px] text-[12px] leading-[16px] text-figma-blue-800">
          {STATUS_LABEL}
        </span>
      </div>
    </div>
  );
}

// `daftar_layout` varian `no_question`: ilustrasi + teks + tombol tambah.
function EmptyQuestionState({ onAdd }) {
  return (
    <div className="flex w-full flex-col items-center justify-center gap-[20px] rounded-[25px] border border-solid border-figma-blue-300 bg-figma-blue-50 p-[40px] text-center">
      <span className="grid size-[100px] place-items-center rounded-[1000px] bg-figma-blue-100">
        <HelpCircle className="size-[48px] text-figma-blue-500" strokeWidth={1.5} aria-hidden="true" />
      </span>

      <div className="flex flex-col gap-[5px]">
        <p className="text-[18px] leading-[28px] font-bold text-figma-blue-800">
          Belum ada pertanyaan
        </p>
        <p className="text-[14px] leading-[20px] font-normal text-figma-blue-400">
          Tambahkan pertanyaan pertama untuk mulai menyusun kuisioner ini.
        </p>
      </div>

      <button
        type="button"
        onClick={onAdd}
        className="flex h-[40.545px] cursor-pointer items-center justify-center gap-[10px] rounded-[1000px] bg-figma-blue-500 px-[40px] py-[10px] text-[12px] leading-[16px] font-normal whitespace-nowrap text-figma-blue-50 transition-opacity hover:opacity-90"
      >
        <Plus className="size-[16px]" strokeWidth={2} aria-hidden="true" />
        Tambah Pertanyaan
      </button>
    </div>
  );
}

// Tombol tambah di dalam `daftar_layout` (dashed), di bawah daftar kartu.
function AddQuestionButton({ onClick, count }) {
  return (
    <button
      type="button"
      onClick={onClick}
      className="flex w-full cursor-pointer flex-col items-center justify-center gap-[5px] rounded-[25px] border border-dashed border-solid border-figma-blue-400 bg-figma-white p-[20px] transition-colors hover:bg-figma-blue-100"
    >
      <span className="flex items-center justify-center gap-[10px] text-figma-blue-800">
        <Plus className="size-[20.545px]" strokeWidth={1.5} aria-hidden="true" />
        <span className="text-[14px] leading-[20px] font-semibold">Tambah Pertanyaan</span>
      </span>
      {count > 0 ? (
        <span className="text-[12px] leading-[16px] font-normal text-figma-blue-400">
          {count} pertanyaan tersusun
        </span>
      ) : null}
    </button>
  );
}

export function QuestionnaireAddPage() {
  const { questions, handleAddQuestion, handleUpdateQuestion, handleRemoveQuestion } =
    useQuestionnaireBuilder();

  const [isAddPopupOpen, setIsAddPopupOpen] = useState(false);

  const openAddPopup = useCallback(() => setIsAddPopupOpen(true), []);
  const closeAddPopup = useCallback(() => setIsAddPopupOpen(false), []);

  // Esc hanya aktif saat popup terbuka
  useEffect(() => {
    if (!isAddPopupOpen) return undefined;

    const onKeyDown = (event) => {
      if (event.key === "Escape") setIsAddPopupOpen(false);
    };

    window.addEventListener("keydown", onKeyDown);
    return () => window.removeEventListener("keydown", onKeyDown);
  }, [isAddPopupOpen]);

  // Popup mengirim (value, key); `key` dipakai sebagai variant instance kartu
  const handleSelectType = useCallback(
    (type, variant) => {
      handleAddQuestion(type, variant);
      setIsAddPopupOpen(false);
    },
    [handleAddQuestion],
  );

  // varian daftar_layout
  const daftarVariant = questions.length === 0 ? "no_question" : "default";

  return (
    <div className="flex w-full flex-col gap-[20px]">
      <PageHeader />

      <div className="flex w-full flex-col items-start gap-[20px] xl:flex-row">
        <section
          data-variant={daftarVariant}
          className="flex min-w-0 flex-1 flex-col gap-[15px] rounded-[25px] border border-solid border-figma-blue-300 bg-figma-blue-50 p-[20px]"
        >
          {daftarVariant === "no_question" ? (
            <EmptyQuestionState onAdd={openAddPopup} />
          ) : (
            <>
              {questions.map((question) => (
                <QuestionEditorCard
                  key={question.id}
                  question={question}
                  onUpdate={handleUpdateQuestion}
                  onRemove={handleRemoveQuestion}
                />
              ))}
              <AddQuestionButton onClick={openAddPopup} count={questions.length} />
            </>
          )}
        </section>

        <QuestionnaireConfigPanel />
      </div>

      <AddQuestionPopup
        open={isAddPopupOpen}
        onClose={closeAddPopup}
        onSelect={handleSelectType}
      />
    </div>
  );
}

export default QuestionnaireAddPage;
